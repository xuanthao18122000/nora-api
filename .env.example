# Application
NODE_ENV=development
APP_PORT=3000
API_URL=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_TYPE=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root123
DB_DATABASE=noravn_db_test

# JWT
JWT_SECRET=please_change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Upload
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_SIZE=20971520

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Namespace prefix gắn vào mọi Redis key — tránh va chạm khi share Redis với app khác.
# Để trống = không prefix. Vd: noravn → key thật "noravn:page:by-code:home_page"
REDIS_KEY_PREFIX=noravn

# Telegram (optional — để trống để tắt notify)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
